		workflow
		{
		form
		{
			auto_set_claim_status as "Auto-Set Claim Status on Submission"
			{
				type =  form
				form = claim_request

				record event = on add

				on success
				{
					actions 
					{
						custom deluge script
						(
											// Set claim_status field to 'Submitted' when claim_request form is created
										input.claim_status = "Submitted";
										// Optional: Log the action for debugging
										info "Claim status set to Submitted for claim reference: " + input.claim_reference_id;
						)
					}
				}

			}
			validate_policy_status as "Validate Policy Status Before Submission"
			{
				type =  form
				form = claim_request

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											// Fetch the policy records linked to the current claim request
										linkedPolicies = policies[ID in input.policy_details_lookup];
										// Check if any linked policy is not Active
										for each  policy in linkedPolicies
										{
											if(policy.policy_status != "Active")
											{
												alert "Cannot submit claim: Linked policy " + policy.policy_number + " is not Active. Please ensure all linked policies are in Active status.";
												cancel submit;
											}
										}
						)
					}
				}

			}
			notify_investigator_approval as "Notify Investigator on Claim Approval"
			{
				type =  form
				form = claim_request

				record event = on edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											// Fetch the claim request record to get assigned investigator and claim status
										claimRecord = claim_request[ID == input.ID];
										// Check if claim status is Approved
										if(claimRecord.claim_status == "Approved")
										{
											// Get the assigned investigator's email
											assignedInvestigatorEmail = claimRecord.assigned_investigator;
											// Get the claim reference ID and claimant name for the email
											claimReferenceId = claimRecord.claim_reference_id;
											claimantName = claimRecord.claimant_name.first_name.concat(" ").concat(claimRecord.claimant_name.last_name);
											// Send email notification to the assigned investigator
											sendmail
											[
												from :zoho.loginuserid
												to :assignedInvestigatorEmail
												subject :"Claim Approved - " + claimReferenceId
												message :"Dear Investigator,\n\nYour assigned claim has been approved.\n\nClaim Reference ID: " + claimReferenceId + "\nClaimant Name: " + claimantName + "\n\nPlease review the approved claim details in the system.\n\nThank you."
											]
										}
						)
					}
				}

			}
		}

		schedule
		{
			daily_review_reminder as "Daily Review Date Reminder"
			{
				type =  schedule
				form = claim_request
					status = inactive
				start = review_date at "10:00:00"
				time zone = "Asia/Kolkata"
				on start
				{
					actions 
					{
					on load
					(
						// Fetch claims pending review today
										pendingClaims = claim_request[claim_status == "Under Review" && review_date == today];
										// Check if there are any pending claims
										if(pendingClaims.count() > 0)
										{
											// Prepare notification message
											claimCount = pendingClaims.count();
											notificationMessage = "You have " + claimCount.toString() + " claim(s) pending review today.";
											// Send notification email to admin
											sendmail
											[
												from :zoho.adminuserid
												to :zoho.adminuserid
												subject :"Claims Pending Review Today"
												message :notificationMessage
											]
										}
					)
					}
				}
			}
		}


