 * Version      : 1.0
 */
 application "Insurance Claim Processing System"
 {
 	date format = "dd-MMM-yyyy"
 	time zone = "America/Los_Angeles"
 	time format = "24-hr"

 	forms
	{
		form claim_request
		{
			displayname = "Claim Request"
			success message = "Request Claimed Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			claim_reference_id
			(
    			type = autonumber
				displayname = "Claim Reference ID"
				start index = 1
	 			row = 1
	 			column = 1   
				width = medium
			)
			claimant_name
			(
    			type = name
				displayname = "Claimant Name"
     			prefix
     			(
	     			 type = prefix
	     			 displayname ="Prefix"
	     			 visibility = false
	     			 value = {"Mr.","Mrs.","Ms."}
     			) 
     			first_name
     			(
	     			 type = first_name
	     			 displayname ="First Name"
     			) 
     			last_name
     			(
	     			 type = last_name
	     			 displayname ="Last Name"
	     			 visibility = false
     			) 
     			suffix
     			(
	     			 type = suffix
	     			 displayname ="Suffix"
	     			 visibility = false
     			) 
	 			row = 1
	 			column = 1   
				width = medium
			)
			claimant_type
			(
				type = picklist
				displayname = "Claimant Type"
				values = {"Nominee","Policyholder","Third Party"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			policy_number
			(
    			type = text
				displayname = "Policy Number"
	 			row = 1
	 			column = 1   
				width = medium
			)
			email_address
			(
    			type = email
				displayname = "Email Address"
	 			row = 1
	 			column = 1   
				width = medium
			)
			contact_number
			(
    			type = phonenumber
				displayname = "Contact Number"
	 			row = 1
	 			column = 1   
				width = medium
			)
			residential_address
			(
    			type = address
				displayname = "Residential Address"
     			capture_coordinates = true
     			adjust_using_map = false
     			address_line_1
     			(
	     			  type = address_line_1
	     			  displayname = "Address Line 1"
     			) 
     			address_line_2
     			(
	     			  type = address_line_2
	     			  displayname = "Address Line 2"
	     			 visibility = false
     			) 
     			district_city
     			(
	     			  type = district_city
	     			  displayname = "City / District"
	     			 visibility = false
     			) 
     			state_province
     			(
	     			  type = state_province
	     			  displayname = "State / Province"
	     			 visibility = false
     			) 
     			postal_Code
     			(
	     			  type = postal_Code
	     			  displayname = "Postal Code"
	     			 visibility = false
     			) 
     			country
     			(
	     			  type = country
	     			  displayname = "Country"
	     			 visibility = false
     			) 
     			latitude
     			(
	     			  type = latitude
	     			  displayname = "Latitude"
	     			 visibility = false
     			) 
     			longitude
     			(
	     			  type = longitude
	     			  displayname = "Longitude"
	     			 visibility = false
     			) 
	 			row = 1
	 			column = 1   
				width = medium
			)
			claim_type
			(
				type = picklist
				displayname = "Claim Type"
				values = {"Life Insurance","Travel Insurance","Property Insurance","Motor Insurance","Health Insurance"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			date_of_incident
			(
    			type = date
				displayname = "Date Of Incident"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			claim_amount_requested
			(
				type = number
				displayname = "Claim Amount Requested"
				maxchar = 19
	 			row = 1
	 			column = 1   
				width = medium
			)
			supporting_documents_available
			(
				type = list	
				displayname = "Supporting Documents Available"
				values = {"Medical Bills","Other Documents","Police FIR Copy","Photographs","Repair Estimate"}
				height = 13px
	 			row = 1
	 			column = 1   
				width = medium
			)
			incident_description
			(
    			type = textarea
				displayname = "Incident Description"
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
			preferred_callback_time
			(
    			type = time
				displayname = "Preferred Callback Time"
				timedisplayoptions = "hh:mm:ss" 
	 			row = 1
	 			column = 1   
				width = medium
			)
			declaration_of_authenticity
			(
    			type = checkbox
				displayname = "Declaration Of Authenticity"
				initial value = false
	 			row = 1
	 			column = 1   
				width = medium
			)
			is_third_party_involved
			(
    			type = checkbox
				displayname = "Is Third Party Involved"
				initial value = false
	 			row = 1
	 			column = 1   
				width = medium
			)
			fir_copy_online_link
			(
    			type = url
				displayname = "FIR Copy Online Link"
	 			row = 1
	 			column = 1   
				width = medium
			)
			damage_photo
			(
    			type = text
				displayname = "Damage Photo"
	 			row = 1
	 			column = 1   
				width = medium
			)
			repair_estimate_upload
			(
    			type = text
				displayname = "Repair Estimate Upload"
	 			row = 1
	 			column = 1   
				width = medium
			)
			policy_sum_insured_lakhs
			(
				type = decimal
				displayname = "Policy Sum Insured Lakhs"
				maxchar = 16
	 			row = 1
	 			column = 1   
				width = medium
			)
			policy_details_lookup
			(
				type = list	
				displayname = "Policy Details Lookup"
				values  = policies.ID
    			displayformat = [policy_number]
				allow new entries
				[
					displayname = "Add New"
				]
				sortorder = ascending
				height = 13px
	 			row = 1
	 			column = 1   
				width = medium
			)
			estimated_repair_cost
			(
				displayname = "Estimated Repair Cost"
				type = USD
	 			row = 1
	 			column = 1   
				width = medium
			)
			depreciation_percent
			(
    			type = percentage
				displayname = "Depreciation Percent"
				maxchar = 16
	 			row = 1
	 			column = 1   
				width = medium
			)
			net_payable_amount
			(
				displayname = "Net Payable Amount"
				type = USD
	 			row = 1
	 			column = 1   
				width = medium
			)
			claim_status
			(
				type = picklist
				displayname = "Claim Status"
				values = {"Submitted","Under Review","Closed","Investigation","Approved","Rejected"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			assigned_investigator
			(
    			type = text
				displayname = "Assigned Investigator"
	 			row = 1
	 			column = 1   
				width = medium
			)
			investigation_notes
			(
    			type = textarea
				displayname = "Investigation Notes"
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
			review_date
			(
    			type = date
				displayname = "Review Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			decision_notes
			(
    			type = textarea
				displayname = "Decision Notes"
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
			claim_submitted_on
			(
    			type = datetime
				displayname = "Claim Submitted On"
				timedisplayoptions = "hh:mm:ss"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
					reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
			blueprint components
			{
				stages = {"Claim Submitted","Under Initial Review","Claim Rejected","Assigned to Investigator","Request Additional Information","Investigation In Progress","Pending Repair Estimate","Claim Approved","Payment Processing","Claim Closed","Payment Failed"}
			}
		}
		form policies
		{
			displayname = "Policy Master"
			success message = "Policy Master Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			policy_number
			(
    			type = text
				displayname = "Policy Number"
	 			row = 1
	 			column = 1   
				width = medium
			)
			policyholder_name
			(
    			type = name
				displayname = "Policyholder Name"
     			prefix
     			(
	     			 type = prefix
	     			 displayname ="Prefix"
	     			 visibility = false
	     			 value = {"Mr.","Mrs.","Ms."}
     			) 
     			first_name
     			(
	     			 type = first_name
	     			 displayname ="First Name"
     			) 
     			last_name
     			(
	     			 type = last_name
	     			 displayname ="Last Name"
	     			 visibility = false
     			) 
     			suffix
     			(
	     			 type = suffix
	     			 displayname ="Suffix"
	     			 visibility = false
     			) 
	 			row = 1
	 			column = 1   
				width = medium
			)
			coverage_type
			(
				type = picklist
				displayname = "Coverage Type"
				values = {"Travel","Motor","Health","Life","Property"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			sum_insured
			(
				displayname = "Sum Insured"
				type = USD
	 			row = 1
	 			column = 1   
				width = medium
			)
			policy_start_date
			(
    			type = date
				displayname = "Policy Start Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			policy_expiry_date
			(
    			type = date
				displayname = "Policy Expiry Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			policy_deductible
			(
				displayname = "Policy Deductible"
				type = USD
	 			row = 1
	 			column = 1   
				width = medium
			)
			policy_status
			(
				type = picklist
				displayname = "Policy Status"
				values = {"Active","Expired","Cancelled"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
					reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
		form witness_details
		{
			displayname = "Witness Details"
			success message = "Witness Details Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			claim_request
			(
				type = list	
				displayname = "Claim Request"
				values  = claim_request.ID
    			displayformat = [claim_reference_id]
				allow new entries
				[
					displayname = "Add New"
				]
				sortorder = ascending
				height = 13px
	 			row = 1
	 			column = 1   
				width = medium
			)
			witness_name
			(
    			type = name
				displayname = "Witness Name"
     			prefix
     			(
	     			 type = prefix
	     			 displayname ="Prefix"
	     			 visibility = false
	     			 value = {"Mr.","Mrs.","Ms."}
     			) 
     			first_name
     			(
	     			 type = first_name
	     			 displayname ="First Name"
     			) 
     			last_name
     			(
	     			 type = last_name
	     			 displayname ="Last Name"
	     			 visibility = false
     			) 
     			suffix
     			(
	     			 type = suffix
	     			 displayname ="Suffix"
	     			 visibility = false
     			) 
	 			row = 1
	 			column = 1   
				width = medium
			)
			witness_contact
			(
    			type = phonenumber
				displayname = "Witness Contact"
	 			row = 1
	 			column = 1   
				width = medium
			)
			witness_statement
			(
    			type = textarea
				displayname = "Witness Statement"
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
					reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
	}
	reports
	{
		list claim_request_Report
		{
			displayName = "All Requests"
			show all rows from claim_request    
			(
				claim_reference_id as "Claim Reference ID"
				claimant_name  as "Claimant Name"
				claimant_type as "Claimant Type"
				policy_number as "Policy Number"
				email_address as "Email Address"
				contact_number as "Contact Number"
				residential_address  as "Residential Address"
	 			(
	      			enable = Link_to_Map,Show_As_Text
	 			)
				claim_type as "Claim Type"
				date_of_incident as "Date Of Incident"
				claim_amount_requested as "Claim Amount Requested"
				supporting_documents_available as "Supporting Documents Available"
				incident_description as "Incident Description"
				preferred_callback_time as "Preferred Callback Time"
				declaration_of_authenticity as "Declaration Of Authenticity"
				is_third_party_involved as "Is Third Party Involved"
				fir_copy_online_link as "FIR Copy Online Link"
				damage_photo as "Damage Photo"
				repair_estimate_upload as "Repair Estimate Upload"
				policy_sum_insured_lakhs as "Policy Sum Insured Lakhs"
				policy_details_lookup as "Policy Details Lookup"
				estimated_repair_cost as "Estimated Repair Cost"
				(
					display = total,average,min,max	
				)
				depreciation_percent as "Depreciation Percent"
				(
					display = total,average,min,max	
				)
				net_payable_amount as "Net Payable Amount"
				(
					display = total,average,min,max	
				)
				claim_status as "Claim Status"
				assigned_investigator as "Assigned Investigator"
				investigation_notes as "Investigation Notes"
				review_date as "Review Date"
				decision_notes as "Decision Notes"
				claim_submitted_on as "Claim Submitted On"
			)
			conditional formatting
			(
				"New Formatting1"
				{
				condition = (claimant_type == "Nominee")
				fields = [claimant_type]
				format = "color:#ffffff;background-color:#765f89;"
				}
				"New Formatting2"
				{
				condition = (claimant_type == "Policyholder")
				fields = [claimant_type]
				format = "color:#000000;background-color:#1bbc9b;"
				}
			)
		}
		kanban claim_request_by_claim_status
		{
			displayName = "Claim Statuses"
			show all rows from claim_request    
			(
				claim_reference_id as "Claim Reference ID"
				claimant_name  as "Claimant Name"
				claimant_type as "Claimant Type"
				policy_number as "Policy Number"
				email_address as "Email Address"
				contact_number as "Contact Number"
				residential_address  as "Residential Address"
	 			(
	      			enable = Link_to_Map,Show_As_Text
	 			)
				claim_type as "Claim Type"
				date_of_incident as "Date Of Incident"
				claim_amount_requested as "Claim Amount Requested"
				supporting_documents_available as "Supporting Documents Available"
				incident_description as "Incident Description"
				preferred_callback_time as "Preferred Callback Time"
				declaration_of_authenticity as "Declaration Of Authenticity"
				is_third_party_involved as "Is Third Party Involved"
				fir_copy_online_link as "FIR Copy Online Link"
				damage_photo as "Damage Photo"
				repair_estimate_upload as "Repair Estimate Upload"
				policy_sum_insured_lakhs as "Policy Sum Insured Lakhs"
				policy_details_lookup as "Policy Details Lookup"
				estimated_repair_cost as "Estimated Repair Cost"
				(
					display = total,average,min,max	
				)
				depreciation_percent as "Depreciation Percent"
				(
					display = total,average,min,max	
				)
				net_payable_amount as "Net Payable Amount"
				(
					display = total,average,min,max	
				)
				claim_status as "Claim Status"
				assigned_investigator as "Assigned Investigator"
				investigation_notes as "Investigation Notes"
				review_date as "Review Date"
				decision_notes as "Decision Notes"
				claim_submitted_on as "Claim Submitted On"
			)
			options
			(
	 			display field = claim_status
	 		)
		}
		list witness_details_Report
		{
			displayName = "All Witness Details"
			show all rows from witness_details    
			(
				claim_request as "Claim Request"
				witness_name  as "Witness Name"
				witness_contact as "Witness Contact"
				witness_statement as "Witness Statement"
			)
		}
		list policies_Report
		{
			displayName = "All Policy Masters"
			show all rows from policies    
			(
				policy_number as "Policy Number"
				policyholder_name  as "Policyholder Name"
				coverage_type as "Coverage Type"
				sum_insured as "Sum Insured"
				(
					display = total,average,min,max	
				)
				policy_start_date as "Policy Start Date"
				policy_expiry_date as "Policy Expiry Date"
				policy_deductible as "Policy Deductible"
				(
					display = total,average,min,max	
				)
				policy_status as "Policy Status"
			)
			conditional formatting
			(
				"New Formatting1"
				{
				condition = (coverage_type == "Health")
				fields = [coverage_type]
				format = "color:#ffffff;background-color:#765f89;"
				}
				"New Formatting2"
				{
				condition = (coverage_type == "Motor")
				fields = [coverage_type]
				format = "color:#000000;background-color:#1bbc9b;"
				}
				"New Formatting3"
				{
				condition = (coverage_type == "Property")
				fields = [coverage_type]
				format = "color:#ffffff;background-color:#e84c3d;"
				}
				"New Formatting4"
				{
				condition = (coverage_type == "Travel")
				fields = [coverage_type]
				format = "color:#ffffff;background-color:#3598db;"
				}
			)
		}
		kanban policies_by_coverage_type
		{
			displayName = "Coverage Types"
			show all rows from policies    
			(
				policy_number as "Policy Number"
				policyholder_name  as "Policyholder Name"
				coverage_type as "Coverage Type"
				sum_insured as "Sum Insured"
				(
					display = total,average,min,max	
				)
				policy_start_date as "Policy Start Date"
				policy_expiry_date as "Policy Expiry Date"
				policy_deductible as "Policy Deductible"
				(
					display = total,average,min,max	
				)
				policy_status as "Policy Status"
			)
			options
			(
	 			display field = coverage_type
	 		)
		}
	}
	pages
	{
		page DashBoard
