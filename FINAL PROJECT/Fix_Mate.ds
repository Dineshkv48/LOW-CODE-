 application "Fix Mate"
 {
 	date format = "dd-MMM-yyyy"
 	time zone = "America/Los_Angeles"
 	time format = "24-hr"

 	forms
	{
		form customer_details
		{
			displayname = "Customer Details"
			success message = "Customer Details Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			customer_name
			(
    			type = name
				displayname = "Customer Name"
     			prefix
     			(
	     			 type = prefix
	     			 displayname ="Prefix"
	     			 visibility = false
	     			 value = {"Mr.","Mrs.","Ms."}
     			) 
     			first_name
     			(
	     			 type = first_name
	     			 displayname ="First Name"
     			) 
     			last_name
     			(
	     			 type = last_name
	     			 displayname ="Last Name"
	     			 visibility = false
     			) 
     			suffix
     			(
	     			 type = suffix
	     			 displayname ="Suffix"
	     			 visibility = false
     			) 
	 			row = 1
	 			column = 1   
				width = medium
			)
			email
			(
    			type = email
				displayname = "Email"
	 			row = 1
	 			column = 1   
				width = medium
			)
			phone_number
			(
    			type = phonenumber
				displayname = "Phone Number"
	 			row = 1
	 			column = 1   
				width = medium
			)
			service_address
			(
    			type = textarea
				displayname = "Service Address"
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
			area_or_city
			(
    			type = text
				displayname = "Area Or City"
	 			row = 1
	 			column = 1   
				width = medium
			)
			customer_code
			(
    			type = text
				displayname = "Customer Code"
	 			row = 1
	 			column = 1   
				width = medium
			)
			registration_date
			(
    			type = date
				displayname = "Registration Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			customer_status
			(
				type = radiobuttons
				displayname = "Customer Status"
				values = {"Active","Inactive"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			preferred_contact_method
			(
				type = picklist
				displayname = "Preferred Contact Method"
				values = {"Email","Phone","WhatsApp"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			total_bookings
			(
				type = number
				displayname = "Total Bookings"
				maxchar = 19
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
					reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
		form service_booking
		{
			displayname = "Service Booking"
			success message = "Data Added Successfully!"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			booking_id
			(
    			type = text
				displayname = "Booking ID"
	 			row = 1
	 			column = 1   
				width = medium
			)
			customer
			(
				type = picklist	
				displayname = "Customer"
				values  = customer_details.ID
    			displayformat = [customer_code]
				allow new entries
				[
					displayname = "Add New"
				]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			service
			(
				type = picklist	
				displayname = "Service"
				values  = service_management.ID
    			displayformat = [service_code]
				allow new entries
				[
					displayname = "Add New"
				]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			booking_date
			(
    			type = date
				displayname = "Booking Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			preferred_service_date
			(
    			type = date
				displayname = "Preferred Service Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			preferred_time
			(
    			type = time
				displayname = "Preferred Time"
				timedisplayoptions = "hh:mm:ss" 
	 			row = 1
	 			column = 1   
				width = medium
			)
			service_address
			(
    			type = textarea
				displayname = "Service Address"
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
			problem_description
			(
    			type = textarea
				displayname = "Problem Description"
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
			assigned_technician
			(
				type = picklist	
				displayname = "Assigned Technician"
				values  = technician_management.ID
    			displayformat = [technician_code]
				allow new entries
				[
					displayname = "Add New"
				]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			service_price
			(
				displayname = "Service Price"
				type = USD
	 			row = 1
	 			column = 1   
				width = medium
			)
			booking_status
			(
				type = picklist
				displayname = "Booking Status"
				values = {"Completed","Technician Assigned","In Progress","Confirmed","Rejected","Cancelled","Pending"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			payment_status
			(
				type = picklist
				displayname = "Payment Status"
				values = {"Paid","Unpaid","Pending","Refunded"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			customer_remarks
			(
    			type = textarea
				displayname = "Customer Remarks"
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
			admin_remarks
			(
    			type = textarea
				displayname = "Admin Remarks"
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
			completion_notes
			(
    			type = textarea
				displayname = "Completion Notes"
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
					reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
			blueprint components
			{
				stages = {"Booking Created","Pending Assignment","Booking Cancelled","Technician Assigned","Service Scheduled","Service In Progress","Service Rescheduled","Service Completed","Service On Hold","Pending Approval","Booking Closed"}
			}
		}
		form service_feedback
		{
			displayname = "Service Feedback"
			success message = "Service Feedback Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			feedback_id
			(
    			type = text
				displayname = "Feedback ID"
	 			row = 1
	 			column = 1   
				width = medium
			)
			booking
			(
				type = picklist	
				displayname = "Booking"
				values  = service_booking.ID
    			displayformat = [booking_id]
				allow new entries
				[
					displayname = "Add New"
				]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			customer
			(
				type = picklist	
				displayname = "Customer"
				values  = customer_details.ID
    			displayformat = [customer_code]
				allow new entries
				[
					displayname = "Add New"
				]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			rating
			(
				type = picklist
				displayname = "Rating"
				values = {"1","2","3","4","5"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			feedback_comments
			(
    			type = textarea
				displayname = "Feedback Comments"
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
			feedback_date
			(
    			type = date
				displayname = "Feedback Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			feedback_status
			(
				type = picklist
				displayname = "Feedback Status"
				values = {"Submitted","Flagged","Reviewed"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			is_duplicate
			(
    			type = checkbox
				displayname = "Is Duplicate"
				initial value = false
	 			row = 1
	 			column = 1   
				width = medium
			)
			feedback_source
			(
				type = picklist
				displayname = "Feedback Source"
				values = {"Web","Phone","Mobile"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
					reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
			blueprint components
			{
				stages = {"Feedback Received","Pending Review","Duplicate Detected","Under Investigation","Resolved","Escalated","Closed"}
			}
		}
		form service_management
		{
			displayname = "Service Management"
			success message = "Service Management Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			service_name
			(
    			type = text
				displayname = "Service Name"
	 			row = 1
	 			column = 1   
				width = medium
			)
			service_category
			(
				type = picklist
				displayname = "Service Category"
				values = {"Plumbing","Appliance Repair","Carpentry","Cleaning","Electrical","AC Repair","Painting","Other"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			description
			(
    			type = textarea
				displayname = "Description"
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
			price
			(
				displayname = "Price"
				type = USD
	 			row = 1
	 			column = 1   
				width = medium
			)
			estimated_duration
			(
				type = number
				displayname = "Estimated Duration"
				maxchar = 19
	 			row = 1
	 			column = 1   
				width = medium
			)
			availability_status
			(
				type = radiobuttons
				displayname = "Availability Status"
				values = {"Available","Unavailable"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			service_code
			(
    			type = text
				displayname = "Service Code"
	 			row = 1
	 			column = 1   
				width = medium
			)
			service_image
			(
    			type = url
				displayname = "Service Image"
	 			row = 1
	 			column = 1   
				width = medium
			)
			is_active
			(
    			type = checkbox
				displayname = "Is Active"
				initial value = false
	 			row = 1
	 			column = 1   
				width = medium
			)
			created_date
			(
    			type = date
				displayname = "Created Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
					reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
		form technician_management
		{
			displayname = "Technician Management"
			success message = "Technician Management Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			technician_name
			(
    			type = name
				displayname = "Technician Name"
     			prefix
     			(
	     			 type = prefix
	     			 displayname ="Prefix"
	     			 visibility = false
	     			 value = {"Mr.","Mrs.","Ms."}
     			) 
     			first_name
     			(
	     			 type = first_name
	     			 displayname ="First Name"
     			) 
     			last_name
     			(
	     			 type = last_name
	     			 displayname ="Last Name"
	     			 visibility = false
     			) 
     			suffix
     			(
	     			 type = suffix
	     			 displayname ="Suffix"
	     			 visibility = false
     			) 
	 			row = 1
	 			column = 1   
				width = medium
			)
			phone_number
			(
    			type = phonenumber
				displayname = "Phone Number"
	 			row = 1
	 			column = 1   
				width = medium
			)
			email
			(
    			type = email
				displayname = "Email"
	 			row = 1
	 			column = 1   
				width = medium
			)
			specialization
			(
				type = picklist
				displayname = "Specialization"
				values = {"Plumbing","Appliance Repair","Carpentry","Cleaning","Electrical","AC Repair","Multi-Service"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			experience_years
			(
				type = number
				displayname = "Experience Years"
				maxchar = 19
	 			row = 1
	 			column = 1   
				width = medium
			)
			availability_status
			(
				type = picklist
				displayname = "Availability Status"
				values = {"Busy","Available","Unavailable"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			technician_code
			(
    			type = text
				displayname = "Technician Code"
	 			row = 1
	 			column = 1   
				width = medium
			)
			technician_notes
			(
    			type = textarea
				displayname = "Technician Notes"
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
			license_number
			(
    			type = text
