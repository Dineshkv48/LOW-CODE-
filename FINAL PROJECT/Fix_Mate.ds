		workflow
		{
		form
		{
			auto_assign_technician as "Auto-Assign Technician on Booking"
			{
				type =  form
				form = service_booking

				record event = on add

				on success
				{
					actions 
					{
						custom deluge script
						(
											// Fetch the service details from the booking
										serviceRecord = service_management[ID == input.service];
										// Get the service specialization from the technician management form
										// We need to find a technician with matching specialization who is available
										specialization = serviceRecord.service_category;
										// Fetch available technicians with matching specialization
										availableTechnicians = technician_management[availability_status == "Available" && specialization == specialization];
										// Check if any available technicians are found
										if(availableTechnicians.count() > 0)
										{
											// Get the first available technician
											selectedTechnician = availableTechnicians;
											// Assign the technician to the booking
											input.assigned_technician = selectedTechnician.ID;
											// Log the assignment
											info "Technician " + selectedTechnician.technician_name.first_name + " " + selectedTechnician.technician_name.last_name + " assigned to booking " + input.booking_id;
										}
										else
										{
											// No available technician found
											info "No available technician found for specialization: " + specialization;
										}
						)
					}
				}

			}
			validate_booking_date as "Validate Booking Date Before Submit"
			{
				type =  form
				form = service_booking

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											// Validate if preferred service date is in the past
										if(input.preferred_service_date != null && input.preferred_service_date < today)
										{
											alert "Error: Preferred service date cannot be in the past. Please select a future date.";
											cancel submit;
										}
						)
					}
				}

			}
		}

		schedule
		{
			daily_technician_reminder as "Daily Technician Availability Reminder"
			{
				type =  schedule
					status = inactive
				start = "2024-05-26 15:53:12"
				time zone = "Asia/Kolkata"
				on start
				{
					actions 
					{
					on load
					(
						// Fetch technicians marked as Unavailable
										unavailableTechnicians = technician_management[availability_status == "Unavailable"];
										// Check if there are any unavailable technicians
										if(unavailableTechnicians.count() > 0)
										{
											// Build notification message
											notificationMessage = "The following technicians are currently marked as Unavailable:\n\n";
											for each  tech in unavailableTechnicians
											{
												notificationMessage = notificationMessage.concat(tech.technician_name.first_name.concat(" ").concat(tech.technician_name.last_name).concat(" - ").concat(tech.phone_number).concat("\n"));
											}
											// Send notification email to admin
											sendmail
											[
												from :zoho.adminuserid
												to :zoho.adminuserid
												subject :"Daily Notification: Unavailable Technicians"
												message :notificationMessage
											]
										}
					)
					}
				}
			}
		}




	}
