	reports
	{
		list service_booking_Report
		{
			displayName = "Service Booking Report"
			show all rows from service_booking    
			(
				booking_id as "Booking ID"
				customer as "Customer"
				service as "Service"
				booking_date as "Booking Date"
				preferred_service_date as "Preferred Service Date"
				preferred_time as "Preferred Time"
				service_address as "Service Address"
				problem_description as "Problem Description"
				assigned_technician as "Assigned Technician"
				service_price as "Service Price"
				(
					display = total,average,min,max	
				)
				booking_status as "Booking Status"
				payment_status as "Payment Status"
				customer_remarks as "Customer Remarks"
				admin_remarks as "Admin Remarks"
				completion_notes as "Completion Notes"
			)
			conditional formatting
			(
				"New Formatting1"
				{
				condition = (payment_status == "Paid")
				fields = [payment_status]
				format = "color:#ffffff;background-color:#765f89;"
				}
				"New Formatting2"
				{
				condition = (payment_status == "Pending")
				fields = [payment_status]
				format = "color:#000000;background-color:#1bbc9b;"
				}
				"New Formatting3"
				{
				condition = (payment_status == "Refunded")
				fields = [payment_status]
				format = "color:#ffffff;background-color:#e84c3d;"
				}
			)
		}
		kanban service_booking_by_booking_status
		{
			displayName = "Booking Statuses"
			show all rows from service_booking    
			(
				booking_id as "Booking ID"
				customer as "Customer"
				service as "Service"
				booking_date as "Booking Date"
				preferred_service_date as "Preferred Service Date"
				preferred_time as "Preferred Time"
				service_address as "Service Address"
				problem_description as "Problem Description"
				assigned_technician as "Assigned Technician"
				service_price as "Service Price"
				(
					display = total,average,min,max	
				)
				booking_status as "Booking Status"
				payment_status as "Payment Status"
				customer_remarks as "Customer Remarks"
				admin_remarks as "Admin Remarks"
				completion_notes as "Completion Notes"
			)
			options
			(
	 			display field = booking_status
	 		)
		}
		list service_feedback_Report
		{
			displayName = "All Service Feedback"
			show all rows from service_feedback    
			(
				feedback_id as "Feedback ID"
				booking as "Booking"
				customer as "Customer"
				rating as "Rating"
				feedback_comments as "Feedback Comments"
				feedback_date as "Feedback Date"
				feedback_status as "Feedback Status"
				is_duplicate as "Is Duplicate"
				feedback_source as "Feedback Source"
			)
			conditional formatting
			(
				"New Formatting1"
				{
				condition = (rating == "1")
				fields = [rating]
				format = "color:#ffffff;background-color:#765f89;"
				}
				"New Formatting2"
				{
				condition = (rating == "3")
				fields = [rating]
				format = "color:#000000;background-color:#1bbc9b;"
				}
				"New Formatting3"
				{
				condition = (rating == "5")
				fields = [rating]
				format = "color:#ffffff;background-color:#e84c3d;"
				}
			)
		}
		kanban service_feedback_by_rating
		{
			displayName = "Service Feedback Board"
			show all rows from service_feedback    
			(
				feedback_id as "Feedback ID"
				booking as "Booking"
				customer as "Customer"
				rating as "Rating"
				feedback_comments as "Feedback Comments"
				feedback_date as "Feedback Date"
				feedback_status as "Feedback Status"
				is_duplicate as "Is Duplicate"
				feedback_source as "Feedback Source"
			)
			options
			(
	 			display field = rating
	 		)
		}
		list technician_management_Report
		{
			displayName = "All Technician Management"
			show all rows from technician_management    
			(
				technician_name  as "Technician Name"
				phone_number as "Phone Number"
				email as "Email"
				specialization as "Specialization"
				experience_years as "Experience Years"
				availability_status as "Availability Status"
				technician_code as "Technician Code"
				technician_notes as "Technician Notes"
				license_number as "License Number"
				join_date as "Join Date"
			)
			conditional formatting
			(
				"New Formatting1"
				{
				condition = (availability_status == "Available")
				fields = [availability_status]
				format = "color:#ffffff;background-color:#765f89;"
				}
				"New Formatting2"
				{
				condition = (availability_status == "Busy")
				fields = [availability_status]
				format = "color:#000000;background-color:#1bbc9b;"
				}
				"New Formatting3"
				{
				condition = (availability_status == "Unavailable")
				fields = [availability_status]
				format = "color:#ffffff;background-color:#e84c3d;"
				}
			)
		}
		kanban technician_management_by_specialization
		{
			displayName = "Specializations"
			show all rows from technician_management    
			(
				technician_name  as "Technician Name"
				phone_number as "Phone Number"
				email as "Email"
				specialization as "Specialization"
				experience_years as "Experience Years"
				availability_status as "Availability Status"
				technician_code as "Technician Code"
				technician_notes as "Technician Notes"
				license_number as "License Number"
				join_date as "Join Date"
			)
			options
			(
	 			display field = specialization
	 		)
		}
		list customer_details_Report
		{
			displayName = "All Customer Details"
			show all rows from customer_details    
			(
				customer_name  as "Customer Name"
				email as "Email"
				phone_number as "Phone Number"
				service_address as "Service Address"
				area_or_city as "Area Or City"
				customer_code as "Customer Code"
				registration_date as "Registration Date"
				customer_status as "Customer Status"
				preferred_contact_method as "Preferred Contact Method"
				total_bookings as "Total Bookings"
			)
			conditional formatting
			(
				"New Formatting1"
				{
				condition = (preferred_contact_method == "Phone")
				fields = [preferred_contact_method]
				format = "color:#ffffff;background-color:#765f89;"
				}
				"New Formatting2"
				{
				condition = (preferred_contact_method == "WhatsApp")
				fields = [preferred_contact_method]
				format = "color:#000000;background-color:#1bbc9b;"
				}
			)
		}
		kanban customer_details_by_preferred_contact_method
		{
			displayName = "Contact Methods"
			show all rows from customer_details    
			(
				customer_name  as "Customer Name"
				email as "Email"
				phone_number as "Phone Number"
				service_address as "Service Address"
				area_or_city as "Area Or City"
				customer_code as "Customer Code"
				registration_date as "Registration Date"
				customer_status as "Customer Status"
				preferred_contact_method as "Preferred Contact Method"
				total_bookings as "Total Bookings"
			)
			options
			(
	 			display field = preferred_contact_method
	 		)
		}
		list service_management_Report
		{
			displayName = "All Service Management"
			show all rows from service_management    
			(
				service_name as "Service Name"
				service_category as "Service Category"
				description as "Description"
				price as "Price"
				(
					display = total,average,min,max	
				)
				estimated_duration as "Estimated Duration"
				availability_status as "Availability Status"
				service_code as "Service Code"
				service_image as "Service Image"
				is_active as "Is Active"
				created_date as "Created Date"
			)
		}
		kanban service_management_by_service_category
		{
			displayName = "Service Categories"
			show all rows from service_management    
			(
				service_name as "Service Name"
				service_category as "Service Category"
				description as "Description"
				price as "Price"
				(
					display = total,average,min,max	
				)
				estimated_duration as "Estimated Duration"
				availability_status as "Availability Status"
				service_code as "Service Code"
				service_image as "Service Image"
				is_active as "Is Active"
				created_date as "Created Date"
			)
			options
			(
	 			display field = service_category
	 		)
		}
	}
